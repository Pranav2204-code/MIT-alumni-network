# ── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/mit_alumni_network
# Production: use MongoDB Atlas URI
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/mit_alumni_network

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_secret_min_64_chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# ── CORS ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://mitwpu-alumni.vercel.app

# ── Admin ──────────────────────────────────────────────────
# Comma-separated PRNs that get admin role on first registration
ADMIN_PRNS=

# ── Points Economy ─────────────────────────────────────────
INITIAL_REFERRAL_POINTS=2
QUIZ_PASS_SCORE=80
POINTS_PER_QUIZ_PASS=1
QUIZ_COOLDOWN_HOURS=168
POINTS_PER_CGPA_MILESTONE=3
CGPA_MILESTONE_THRESHOLD=8.5
